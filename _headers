# CSP: one strict policy site-wide.
#
# As of the 2026-10-27 Strix remediation, every page's inline module
# scripts live in .page.js files and every inline on* handler attribute
# is replaced by a delegated listener (data-action in the page module,
# data-copy-email / data-nav-reload in nav.js). Nothing served here
# needs 'unsafe-inline' for scripts any more, so the /* policy below is
# the strict one: script-src 'self' https://esm.sh, no 'unsafe-inline'.
# The per-page blocks further down repeat that policy explicitly (and
# /login.html additionally allows the Cloudflare Turnstile hosts it
# needs); they are overrides, not a second tier.
#
# MAINTENANCE: adding an inline <script> block or an inline on* handler
# to ANY page will stop that code from running. Put the code in a .js
# file and bind events with addEventListener instead.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://esm.sh https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://hjaywokvgdzhvsoygctc.supabase.co; connect-src 'self' https://hjaywokvgdzhvsoygctc.supabase.co wss://hjaywokvgdzhvsoygctc.supabase.co https://esm.sh https://api.mcstatus.io https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), midi=(), display-capture=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-site
  X-Permitted-Cross-Domain-Policies: none

# Service worker script: must always be revalidated so an update to the
# cache strategy actually reaches visitors instead of being served stale
# from a CDN or browser HTTP cache.
/sw.js
  Cache-Control: no-cache

# Manifest is small and rarely changes, but keep it revalidating too since
# it drives installed-app metadata (name, icons, theme color).
/manifest.json
  Cache-Control: no-cache

# Images, the vendor QR library, style.css and nav.js are not content-hashed
# (same filename across deploys), so nothing here is marked immutable —
# each rule instead caches for a bounded window and revalidates after that,
# so a deploy is never stale for longer than the window and a normal
# multi-page visit within it reuses the cached copy instead of re-fetching
# the same shared files on every page.
/images/*
  Cache-Control: public, max-age=86400, must-revalidate

/vendor/*
  Cache-Control: public, max-age=604800, must-revalidate

/style.css
  Cache-Control: public, max-age=300, must-revalidate

/nav.js
  Cache-Control: public, max-age=300, must-revalidate

